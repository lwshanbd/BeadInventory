    "help.data.backup.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app auto-backs up weekly. To export manually: More → Data & Backup → Export Inventory Data, choose CSV or JSON format."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 会每周自动备份一次。你也可以手动导出：进入「更多」→「数据与备份」→「导出库存数据」，选择 CSV 或 JSON 格式。"
          }
        }
      }
    },
    "help.data.backup.title" : {
