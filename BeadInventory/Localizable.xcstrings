    "help.faq.scanaccuracy.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the image is clear and only shows the color count table. You can manually edit results after scanning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
