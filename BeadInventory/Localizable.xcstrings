    "将「%@」合并到「%@」，源品牌的库存、项目和购买记录将全部转移到目标品牌，此操作不可撤销。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge \"%1$@\" into \"%2$@\". All stock, projects, and purchase records from the source brand will be transferred to the target brand. This action cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将「%1$@」合并到「%2$@」，源品牌的库存、项目和购买记录将全部转移到目标品牌，此操作不可撤销。"
          }
        }
      }
    },
    "将「%@」所有颜色的库存重置为 %@ 颗，使用记录也将清零。此操作不可撤销。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset stock for all colors of \"%1$@\" to %2$@ pcs and clear usage records. This action cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将「%1$@」所有颜色的库存重置为 %2$@ 颗，使用记录也将清零。此操作不可撤销。"
          }
        }
      }
    },
    "将从库存中扣减 %lld 颗豆子，共 %lld 种颜色。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld beads across %2$lld colors will be deducted from stock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从库存中扣减 %1$lld 颗豆子，共 %2$lld 种颜色。"
          }
        }
      }
    },
    "将从库存中扣减 %lld 颗豆子，共 %lld 种颜色。\n\n⚠️ 以下 %lld 种颜色扣除后库存将为负数：\n%@" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld beads across %2$lld colors will be deducted from stock.\n\n⚠️ The following %3$lld colors will have negative stock after deduction:\n%4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从库存中扣减 %1$lld 颗豆子，共 %2$lld 种颜色。\n\n⚠️ 以下 %3$lld 种颜色扣除后库存将为负数：\n%4$@"
          }
        }
      }
    },
    "将创建包含 %lld 颗豆子（%lld 种颜色）的计划项目。执行时需要选择品牌。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A planned project containing %1$lld beads (%2$lld colors) will be created. You will need to choose a brand when executing it."
          }
        },
