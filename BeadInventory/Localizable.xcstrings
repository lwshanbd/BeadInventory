    },
    "help.faq.dataloss.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app auto-backs up weekly. With iCloud, data syncs to the cloud. We recommend regular manual exports as extra backup. All operations support history and undo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 每周自动备份，开启 iCloud 后数据还会同步到云端。建议定期手动导出数据作为额外备份。所有操作都支持历史记录和撤回。"
          }
        }
      }
    },
    "help.faq.dataloss.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Will my inventory data be lost?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "库存数据会丢失吗？"
          }
        }
      }
    },
    "help.faq.multisync.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure all devices are signed into the same iCloud account. Data syncs automatically, usually in seconds to minutes. Check sync status on the More page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保所有设备登录同一个 iCloud 账号。数据会自动同步，通常需要几秒到几分钟。在「更多」页面可以查看 iCloud 同步状态。"
          }
        }
      }
    },
