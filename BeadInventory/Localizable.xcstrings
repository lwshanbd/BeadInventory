      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to More → Data & Backup → Export Inventory Data. Export as CSV or JSON to share or view in other tools."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进入「更多」→「数据与备份」→「导出库存数据」，可以导出为 CSV 或 JSON 文件，方便分享或在其他工具中查看。"
          }
        }
      }
    },
