    "help.data.icloud.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your device is signed into iCloud, data syncs automatically across devices. Sync isn't instant; it usually takes seconds to minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的设备已登录 iCloud，数据会自动在多设备之间同步。同步不是实时的，通常需要几秒到几分钟。"
          }
        }
      }
    },
    "help.data.icloud.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
