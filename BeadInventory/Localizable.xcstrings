    },
    "help.faq.dataloss.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app auto-backs up weekly. With iCloud, data syncs to the cloud. We recommend regular manual exports as extra backup. All operations support history and undo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 每周自动备份，开启 iCloud 后数据还会同步到云端。建议定期手动导出数据作为额外备份。所有操作都支持历史记录和撤回。"
          }
        }
      }
    },
    "help.faq.dataloss.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Will my inventory data be lost?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "库存数据会丢失吗？"
          }
        }
      }
    },
    "help.faq.localvscloud.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud API (recommended): needs internet and an API key, but is more accurate, faster, and supports more formats. Local model: works offline after download, but accuracy and speed are lower and it takes up device storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐使用云端 API：识别更准确、速度更快，支持更多格式，需要网络和 API Key。本地模型仅建议离线场景使用：下载后可脱网使用，但识别准确率和速度较低，且占用本机存储。"
          }
        }
      }
    },
    "help.faq.localvscloud.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's the difference between local and cloud?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地模型和云端 API 有什么区别？"
          }
        }
      }
    },
    "help.faq.multisync.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure all devices are signed into the same iCloud account. Data syncs automatically, usually in seconds to minutes. Check sync status on the More page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保所有设备登录同一个 iCloud 账号。数据会自动同步，通常需要几秒到几分钟。在「更多」页面可以查看 iCloud 同步状态。"
          }
        }
      }
    },
    "help.faq.multisync.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to sync between devices?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何在多设备之间同步？"
          }
        }
      }
    },
    "help.faq.scanaccuracy.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the image is clear and only shows the color count table. Try cloud API (usually more accurate than local models). You can manually edit results after scanning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确保图片清晰，只保留色号统计表格部分。尝试使用云端 API（通常比本地模型更准确）。识别完成后可以手动编辑修正。"
          }
        }
      }
    },
    "help.faq.scanaccuracy.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if scan recognition is inaccurate?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描识别不准怎么办？"
          }
        }
      }
    },
    "help.faq.whatisapi.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An API key connects to cloud AI services. BeadInventory is free; to avoid charging users, the scan feature requires your own free API key. Alternatively, download a local model to skip API setup entirely."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 是连接云端 AI 服务的密钥。啃豆小仓是免费 App，为了不向用户收费，扫描识别功能需要你自己申请一个免费的 API Key。你也可以选择下载本地模型来避免配置 API。"
          }
        }
      }
    },
    "help.faq.whatisapi.question" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is an API? Why configure it?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 是什么？为什么要配置？"
          }
        }
      }
    },
