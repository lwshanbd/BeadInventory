    "help.faq.brands.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Currently supports MARD, vivid, Manman, Kaka and other major bead brands. Color data is continuously updated."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前支持 MARD、vivid、漫漫、卡卡等主流拼豆品牌之间的色号对照。色号数据会持续更新。"
          }
        }
      }
    },
    "help.faq.brands.question" : {
