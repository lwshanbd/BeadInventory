    "help.scan.apisetup.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BeadInventory offers two AI modes: download a local model (recommended for beginners, no setup needed), or configure a cloud API (more accurate). Go to More → Settings → AI Image Recognition."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啃豆小仓提供两种 AI 识别方式：下载本地模型（推荐新手，无需配置），或配置云端 API（识别更准确）。进入「更多」→「设置」→「AI 图像识别」进行配置。"
          }
        }
      }
    },
