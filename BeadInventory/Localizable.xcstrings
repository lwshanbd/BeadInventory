    "help.faq.whatisapi.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An API key connects to cloud AI services. BeadInventory is free; to avoid charging users, the scan feature requires your own free API key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 是连接云端 AI 服务的密钥。啃豆小仓是免费 App，为了不向用户收费，扫描识别功能需要你自己申请一个免费的 API Key。"
          }
        }
      }
    },
