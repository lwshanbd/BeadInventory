    "help.quickstart.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to More → Brand Management, tap + to add your bead brand (e.g. MARD, Kaka)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进入「更多」→「品牌管理」，点击右上角 + 号添加你使用的拼豆品牌（如 MARD、卡卡等）。"
          }
        }
      }
