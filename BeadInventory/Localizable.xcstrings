    "help.colortools.hide.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you never use certain colors, long-press on them in inventory to hide. Hidden colors won't show in the list but data is preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某些色号你从来不用，可以在库存页长按色号选择隐藏。隐藏后不会出现在库存列表中，但数据不会删除。"
          }
        }
      }
    },
