          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步"
          }
        }
      }
    },
    "help.data.restore.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to More → Data & Backup → Restore Backup to restore from auto-backups. Or use Import Historical Data to restore from backup files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进入「更多」→「数据与备份」→「恢复备份」，可以从自动备份中选择恢复。也可以通过「导入历史数据」从备份文件恢复。"
          }
        }
      }
    },
