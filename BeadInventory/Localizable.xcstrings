    "help.colortools.custom.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In More → Custom Colors, add colors not in the official palette. Custom colors appear in your inventory and work like regular ones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「更多」→「自定义色号」中，可以添加官方色表中没有的颜色。自定义色号会出现在库存中，可以正常使用。"
          }
        }
      }
    },
