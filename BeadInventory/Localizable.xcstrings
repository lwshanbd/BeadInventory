    "help.colortools.convert.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a color code from any brand to see matching codes from other brands. Supports cross-reference between MARD, vivid, Manman, Kaka, etc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入任意品牌的色号，自动查询对应的其他品牌色号。支持 MARD、vivid、漫漫、卡卡等品牌之间的对照。"
          }
        }
      }
    },
    "help.colortools.convert.title" : {
      "extractionState" : "manual",
