      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare to pattern"
          }
        }
      }
    },
    "本次无法读取图纸上的该区域，无法对照图纸，请参照实物修改。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load this part of the pattern, so there's nothing to compare against — edit it against the piece in your hand."
          }
        }
      }
    },
    "清除 / 填补" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase / Add"
          }
        }
      }
    },
    "该区域尚未识别颜色" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This piece hasn't been colour-read yet"
          }
        }
      }
    },
    "请先完成「核对颜色」，再返回进行清除或填补。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run “See each cell's colour” first, then come back to erase or add."
